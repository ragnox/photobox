{
  "name": "photobox",
  "version": "0.1.0",
  "description": "Local-first photo library: Google Takeout import, timeline, folder watching.",
  "scripts": {
    "start": "node bin/photobox.js serve",
    "desktop": "electron .",
    "scan": "node bin/photobox.js scan",
    "test": "node --test \"test/*.test.js\"",
    "fake-takeout": "node scripts/make-fake-takeout.js",
    "icon": "node scripts/make-icon.js",
    "dist:mac": "electron-builder --mac",
    "dist:dir": "electron-builder --dir"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@photostructure/tz-lookup": "^11.7.0",
    "chokidar": "^6.0.0",
    "exifr": "^7.1.3",
    "express": "^5.3.0",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  },
  "private": true,
  "bin": {
    "photobox": "bin/photobox.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "main": "desktop/main.js",
  "build": {
    "appId": "local.photobox.app",
    "productName": "Photobox",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "src/**/*",
      "public/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        "dmg"
      ],
      "identity": null,
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Photobox"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics"
    },
    "electronLanguages": [
      "en",
      "de"
    ]
  }
}
