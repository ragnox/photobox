{
  "name": "photobox",
  "version": "0.2.0",
  "description": "Local-first photo library and verified phone backup, with a macOS menu-bar host.",
  "author": "Photobox contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/ragnox/photobox.git"
  },
  "homepage": "https://github.com/ragnox/photobox#readme",
  "bugs": {
    "url": "https://github.com/ragnox/photobox/issues"
  },
  "scripts": {
    "start": "node bin/photobox.js serve",
    "desktop": "electron .",
    "predesktop": "node scripts/make-tray-icons.js",
    "scan": "node bin/photobox.js scan",
    "test": "node --test \"test/*.test.js\"",
    "fake-takeout": "node scripts/make-fake-takeout.js",
    "icon": "node scripts/make-icon.js",
    "dist:mac": "node scripts/build-macos.js",
    "dist:dir": "node scripts/build-macos.js --dir",
    "test:desktop": "node scripts/desktop-smoke.js",
    "test:ui": "node --test \"test/ui/*.test.js\""
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@photostructure/tz-lookup": "^11.7.0",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.6",
    "chokidar": "^6.0.0",
    "exifr": "^7.1.3",
    "express": "^5.3.0",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "srvx": "^0.11.22"
  },
  "private": true,
  "bin": {
    "photobox": "bin/photobox.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "main": "desktop/main.js",
  "build": {
    "appId": "local.photobox.app",
    "productName": "Photobox",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "src/**/*",
      "public/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "npmRebuild": false,
    "extraResources": [{ "from": "build/licenses", "to": "licenses" }],
    "afterSign": "scripts/notarize.js",
    "artifactName": "Photobox-${version}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Photobox"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics"
    },
    "electronLanguages": [
      "en",
      "de"
    ]
  }
}
